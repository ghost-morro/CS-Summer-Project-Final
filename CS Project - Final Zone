            int lenght = UserPassword.Length;
            lenght = lenght - 1;

            while (lenght < 7)
            {
                if (lenght < 7)
                {
                    Console.WriteLine();
                    Console.ForegroundColor = ConsoleColor.DarkGray;
                    Console.WriteLine("Password needs to be Longer");
                    Console.WriteLine("Minimum character count is 8");
                    Console.ForegroundColor = ConsoleColor.White;
                    UserPassword = Console.ReadLine();
                    UserPassword = UserPassword.ToString();
                    lenght = UserPassword.Length;
                    lenght = lenght - 1;
                }
            }
            while (lenght > 23)
            {
                if (lenght > 23)
                {
                    Console.WriteLine();
                    Console.ForegroundColor = ConsoleColor.DarkGray;
                    Console.WriteLine("Password needs to be Shorter");
                    Console.WriteLine("Maximum character count is 24");
                    Console.ForegroundColor = ConsoleColor.White;
                    UserPassword = Console.ReadLine();
                    UserPassword = UserPassword.ToString();
                    lenght = UserPassword.Length;
                    lenght = lenght - 1;
                }
            }

            char[] chars = new char[UserPassword.Length];

            for (int i = 0; i < lenght; i++)
            {
                chars[i] = UserPassword[i];
            }
        
            for (int i = 0; lenght > i; i++)
            {
                if (char.IsUpper(chars[i]))
                {
                    Points = Points + 5;                  
                    i = i + lenght;
                }
            }

            for (int i = 0; i < lenght; i++)
            {
                if (char.IsLower(chars[i]))
                {
                    Points = Points + 5;                 
                    i = i + lenght;
                }
            }
       
            for (int i = 0; lenght > i; i++)
            {
                if (char.IsNumber(chars[i]))
                {
                    Points = Points + 5;                
                    i = i + lenght;
                }
            }
       
            for (int i = 0; i < chars.Length; i++)
            {
                if ("+-()&^%$£".Contains(chars[i]))
                {
                    Points = Points + 5;                   
                    i = i + lenght;
                }
            }
         
            for (int i = 0; i < chars.Length; i++)
            {
                for (int k = 0; k < chars.Length; k++)
                {
                    for (int p = 0; p < chars.Length; p++)
                    {
                        for (int q = 0; q < chars.Length; q++)
                        {
                            if (char.IsUpper(chars[i]) && char.IsNumber(chars[k]) && char.IsLower(chars[p]) && ("+-()&^%$£".Contains(chars[q])))
                            {
                                Points = Points + 10;
                                i = i + lenght;
                                k = k + lenght;
                                p = p + lenght;
                                q = q + lenght;
                            }
                        }
                    }
                }
            }

            for (int i = 0; i < chars.Length; i++)
            {
                if (char.IsUpper(chars[i]) && char.IsLower(chars[i]) && !char.IsNumber(chars[i]) && !"+-()&^%$£".Contains(chars[i]))
                {
                    Points = Points - 5;                   
                    i = i + chars.Length;
                }
            }

            for (int i = 0; i < chars.Length; i++)
            {
                if (!char.IsNumber(chars[i]) && char.IsLower(chars[i]) && char.IsUpper(chars[i]) && "+-()&^%$£".Contains(chars[i]))
                {
                    Points = Points - 5;               
                    i = i + chars.Length;
                }
            }

            for (int i = 0; i < chars.Length; i++)
            {
                if ("+-()&^%$£".Contains(chars[i]) && !char.IsUpper(chars[i]) && !char.IsLower(chars[i]) && !char.IsNumber(chars[i]))
                {
                    Points = Points - 5;                  
                    i = i + chars.Length;
                }
            }

            string KeyboardLayout = "qwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM"; 

            for (int i = 0; i < chars.Length; i++)
            {
                for (int k = 0; k < chars.Length; k++)
                {
                    if (chars[i] == KeyboardLayout[k] && chars[i + 1] == KeyboardLayout[k + 1] && chars[i + 2] == KeyboardLayout[k + 2])
                    {
                        Points = Points - 5;                  
                        break;
                    }
                }
            }

            Points = Points + lenght + 1;
            Console.WriteLine();
            Console.ForegroundColor = ConsoleColor.DarkGray;
            Console.Write("You scored a... '");
            Console.ForegroundColor = ConsoleColor.White;
            Console.Write(Points);
            Console.ForegroundColor = ConsoleColor.DarkGray;
            Console.Write("', which means-");
            Console.ForegroundColor = ConsoleColor.White;
            Console.ReadLine();

            if (Points >= 30)
            {
                Console.ForegroundColor = ConsoleColor.DarkGreen;
                Console.WriteLine("Your Password is one that rivals kings judgment!");
                Console.ForegroundColor = ConsoleColor.White;
                Console.WriteLine("");
                Console.WriteLine("You will be taken back to the menu.");
                Console.WriteLine();
                Console.WriteLine("---------------------------------------------");
                Console.ReadLine();
                Questions();
            }
            if (Points >= 20)
            {
                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine("Your Password is a strong one!");
                Console.ForegroundColor = ConsoleColor.White;
                Console.WriteLine("");
                Console.WriteLine("You will be taken back to the menu.");
                Console.WriteLine("|");
                Console.ReadLine();
                Questions();
            }
            if (Points >= 1 && Points <= 19)
            {
                Console.ForegroundColor = ConsoleColor.Yellow;
                Console.WriteLine("Your Password average in strength");
                Console.ForegroundColor = ConsoleColor.White;
                Console.WriteLine("");
                Console.WriteLine("You will be taken back to the menu.");
                Console.WriteLine();
                Console.WriteLine("---------------------------------------------");
                Console.ReadLine();
                Questions();
            }
            if (Points <= 0)
            {
                Console.ForegroundColor = ConsoleColor.DarkRed;
                Console.WriteLine("Your Password is quite weak...");
                Console.ForegroundColor = ConsoleColor.White;
                Console.WriteLine("");
                Console.WriteLine("You will be taken back to the menu.");
                Console.WriteLine();
                Console.WriteLine("---------------------------------------------");
                Console.ReadLine();
                Questions();
            }     
            Console.ReadKey();
        }

